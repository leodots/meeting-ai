# Database (change user/password as needed)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/meeting_ai"

# Encryption key for API keys stored in database (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=""

# Authentication (generate with: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Default user credentials (CHANGE THESE - required on first run)
# The first login with these credentials will create the admin user
AUTH_EMAIL=""
AUTH_PASSWORD=""

# Note: AssemblyAI and Gemini API keys are now managed through the Settings page
# They are stored encrypted in the database

# File Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB="300"
NEXT_PUBLIC_MAX_FILE_SIZE_MB="300"

# Optional internal upload endpoint for trusted automation (for example Jarvis)
# Send Authorization: Bearer <token> to /api/internal/jarvis/upload
JARVIS_UPLOAD_TOKEN=""
JARVIS_UPLOAD_USER_EMAIL=""

# App Settings
NEXT_PUBLIC_APP_NAME="Meeting AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
